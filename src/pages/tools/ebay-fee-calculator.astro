---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';
import { ebayCategories, ebayPerOrderUnder10, ebayPerOrderOver10, ebayInsertionFee, ebayFreeListingsPerMonth } from '../../data/fees';

const tool = tools.find((t) => t.slug === 'ebay-fee-calculator')!;
const related = tools.filter((t) => t.slug !== tool.slug).slice(0, 3);

const title = 'eBay Fee & Profit Calculator — Real Profit Per Sale | emallsoon';
const description =
  'Free eBay fee calculator. Enter price, category, promoted listings rate, and shipping to see real profit per sale. Includes Store subscriber savings and per-order fees. No signup.';

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'eBay Fee Calculator',
  url: 'https://emallsoon.com/tools/ebay-fee-calculator/',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  description:
    'Free eBay fee and profit calculator: final value fees by category, per-order fees, insertion fees, promoted listings ad fees, Store subscriber savings, and true profit per sale.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://emallsoon.com/' },
    { '@type': 'ListItem', position: 2, name: 'eBay Fee Calculator', item: 'https://emallsoon.com/tools/ebay-fee-calculator/' },
  ],
};

const faqs = [
  {
    q: 'How much does eBay charge sellers?',
    a: 'eBay charges a final value fee of 2.5% to 15.3% depending on the category, plus a per-order fee of $0.30 for orders $10 or less and $0.40 for orders over $10. For most categories the rate is 13.6% for individual sellers and 12.7% for Store subscribers. The fee is calculated on the total amount of the sale, which includes item price, shipping charged to the buyer, sales tax, and handling charges.',
  },
  {
    q: 'Are there listing fees on eBay?',
    a: 'eBay gives you 250 free listings per month. After that, each additional listing costs $0.35. If you list fewer than 250 items per month (which covers most casual sellers), you pay zero insertion fees. Optional listing upgrades like subtitles ($2), gallery plus, or reserve prices incur additional fees at the time of listing, regardless of whether the item sells.',
  },
  {
    q: 'Is an eBay Store subscription worth it?',
    a: 'It depends on your category and volume. Store subscriptions start at $4.95/month (Starter) and go up to $2,999.95/month (Enterprise). The main benefit is discounted final value fees and more free monthly listings. For example, a Basic Store ($21.95/month on annual billing — $27.95 month-to-month) reduces electronics fees from 13.6% to 9.35% — saving 4.25% per sale. If you sell $600/month of electronics, the subscription saves you $25.50/month, more than the fee. Use the calculator with the Store toggle on to see if your volume justifies the subscription.',
  },
  {
    q: 'What are promoted listings and do I need them?',
    a: 'Promoted Listings Standard is eBay\'s optional advertising program. You set an ad rate (1% to 20% of the sale price) and only pay if your item sells through a promoted placement. The ad fee is calculated as: sale price × ad rate %. For most sellers, 2–5% is enough to boost visibility without eating margin. The calculator lets you enter your promoted listings rate to see the impact on profit.',
  },
  {
    q: 'How does eBay calculate the final value fee?',
    a: 'The final value fee is calculated on the total amount of the sale: item price + shipping charged to buyer + sales tax + handling charges. For most categories as an individual seller, that is 13.6% of the total, plus a per-order fee. High-value sales get a lower rate on the portion above a category threshold: for most categories 2.35% above $7,500, while Store subscribers hit the reduced rate sooner at $2,500. Exceptions: Jewelry & Watches pays 9% above $5,000 (7% for stores), Auto Parts store subscribers above just $1,000, and Coins & Paper Money store subscribers above $4,000. The calculator applies these tiered rates automatically based on your inputs.',
  },
  {
    q: 'Why is my eBay profit lower than expected?',
    a: 'Most sellers budget for the 13.6% final value fee and forget the per-order fee ($0.30–$0.40), promoted listings ad fees (2–5% if used), shipping costs they pay out of pocket, and insertion fees if they exceed 250 listings/month. A $30 sale with 13.6% final value fee ($4.08) plus $0.40 per-order fee looks like $25.52 in fees — but add 3% promoted listings ($0.90) and $8 shipping you pay, and your net is $16.62 before product cost. Run every sale through the calculator with all layers filled in.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const perOrderUnder10 = ebayPerOrderUnder10;
const perOrderOver10 = ebayPerOrderOver10;
const insertionFee = ebayInsertionFee;
const freeListings = ebayFreeListingsPerMonth;
---

<BaseLayout
  title={title}
  description={description}
  path={tool.href}
  jsonLd={[softwareJsonLd, breadcrumbJsonLd, faqJsonLd]}
>
  <section class="section--tight section">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span class="sep">/</span>
        <a href="/#tools">Tools</a><span class="sep">/</span>
        <span>eBay Fee Calculator</span>
      </nav>

      <header class="page-head">
        <p class="eyebrow">eBay · free · no signup</p>
        <h1>eBay Fee & Profit Calculator</h1>
        <p class="lede">
          eBay's 13.6% final value fee is just the headline. Stack on the
          per-order charge, promoted listings, shipping, and optional
          upgrades — then see what actually lands in your bank account per
          sale.
        </p>
      </header>

      <div class="calc-grid">
        <form class="calc-form" id="ebay-form" autocomplete="off">
          <div class="form-sec">
            <p class="fs-title">Sale details</p>
            <div class="form-grid">
              <div class="field">
                <label for="price">Selling price</label>
                <div class="input-shell">
                  <span class="affix">$</span>
                  <input type="number" id="price" value="50.00" min="0" step="0.01" inputmode="decimal" />
                </div>
              </div>
              <div class="field">
                <label for="category">Category</label>
                <select id="category">
                  {ebayCategories.map((c) => (
                    <option
                      value={c.id}
                      data-individual={c.individualPct}
                      data-store={c.storePct}
                      data-per-order={c.perOrderFeeApplies ? '1' : '0'}
                      data-ind-threshold={c.individualThreshold ?? ''}
                      data-ind-over={c.individualOverPct ?? ''}
                      data-store-threshold={c.storeThreshold ?? ''}
                      data-store-over={c.storeOverPct ?? ''}
                    >{c.label}</option>
                  ))}
                </select>
                <span class="hint">Final value fee varies by category</span>
              </div>
              <div class="field">
                <label for="shipping">Shipping charged to buyer</label>
                <div class="input-shell">
                  <span class="affix">$</span>
                  <input type="number" id="shipping" value="10.00" min="0" step="0.01" inputmode="decimal" />
                </div>
                <span class="hint">If free shipping, enter 0</span>
              </div>
              <div class="field field-toggle">
                <label>
                  <input type="checkbox" id="store-sub" />
                  <span>I have an eBay Store subscription</span>
                </label>
                <span class="hint">Unlocks discounted final value fees</span>
              </div>
            </div>
          </div>

          <div class="form-sec">
            <p class="fs-title">Costs per sale</p>
            <div class="form-grid">
              <div class="field">
                <label for="cost">Product cost <span class="opt">(landed)</span></label>
                <div class="input-shell">
                  <span class="affix">$</span>
                  <input type="number" id="cost" value="20.00" min="0" step="0.01" inputmode="decimal" />
                </div>
                <span class="hint">Unit cost incl. inbound shipping</span>
              </div>
              <div class="field">
                <label for="fulfillment">Shipping you pay</label>
                <div class="input-shell">
                  <span class="affix">$</span>
                  <input type="number" id="fulfillment" value="8.00" min="0" step="0.01" inputmode="decimal" />
                </div>
                <span class="hint">Carrier cost via eBay Labels or your own</span>
              </div>
              <div class="field">
                <label for="promoted">Promoted listings rate <span class="opt">(optional)</span></label>
                <div class="input-shell">
                  <input type="number" id="promoted" value="3" min="0" max="20" step="0.5" inputmode="decimal" />
                  <span class="affix">%</span>
                </div>
                <span class="hint">Only charged if sold via promoted ad</span>
              </div>
              <div class="field">
                <label for="upgrades">Listing upgrades <span class="opt">(optional)</span></label>
                <div class="input-shell">
                  <span class="affix">$</span>
                  <input type="number" id="upgrades" value="0.00" min="0" step="0.50" inputmode="decimal" />
                </div>
                <span class="hint">Subtitle, bold, gallery plus, etc.</span>
              </div>
            </div>
          </div>
        </form>

        <aside class="calc-sticky" aria-label="Results">
          <div class="receipt">
            <div class="receipt-inner">
              <div class="receipt-head">
                <p class="rh-title">eBay Profit Receipt</p>
                <p class="rh-sub">per sale · live</p>
              </div>

              <div class="rline"><span class="rl-label">Total sale amount</span><span class="rl-dots"></span><span class="rl-val" id="r-total">$0.00</span></div>
              <div class="rline rline--fee"><span class="rl-label">Final value fee <span class="rl-sub-label" id="t-fvf-rate">(13.6%)</span></span><span class="rl-dots"></span><span class="rl-val" id="r-fvf">−$0.00</span></div>
              <div class="rline rline--fee"><span class="rl-label">Per-order fee</span><span class="rl-dots"></span><span class="rl-val" id="r-perorder">−$0.00</span></div>
              <div class="rline rline--fee"><span class="rl-label">Promoted listings</span><span class="rl-dots"></span><span class="rl-val" id="r-promoted">−$0.00</span></div>
              <div class="rline rline--fee"><span class="rl-label">Listing upgrades</span><span class="rl-dots"></span><span class="rl-val" id="r-upgrades">−$0.00</span></div>

              <div class="rline rline--total">
                <span class="rl-label">Net revenue</span>
                <span class="rl-dots"></span>
                <span class="rl-val num" id="r-net" aria-live="polite">$0.00</span>
              </div>
              <div class="rline rline--fee"><span class="rl-label">Product cost</span><span class="rl-dots"></span><span class="rl-val" id="r-cost">−$0.00</span></div>
              <div class="rline rline--fee"><span class="rl-label">Shipping you pay</span><span class="rl-dots"></span><span class="rl-val" id="r-fulfillment">−$0.00</span></div>

              <div class="rline rline--total">
                <span class="rl-label">Profit / sale</span>
                <span class="rl-dots"></span>
                <span class="rl-val num" id="r-profit" aria-live="polite">$0.00</span>
              </div>
              <div class="rline rline--meta"><span class="rl-label">Margin</span><span class="rl-dots"></span><span class="rl-val" id="r-margin">0%</span></div>
              <div class="rline rline--meta"><span class="rl-label">Total platform take</span><span class="rl-dots"></span><span class="rl-val" id="r-take">0%</span></div>

              <div class="verdict pos" id="r-verdict">profitable ✓</div>

              <button type="button" class="copy-btn" id="copy-btn">Copy results</button>

              <p class="disclaimer">
                Final value fee is calculated on total sale amount (price +
                shipping + tax). Per-order fee is $0.30 for orders ≤$10,
                $0.40 for orders >$10. High-value sales: only the portion
                above the category threshold ($7,500 for most categories,
                $2,500 for Store subscribers) is charged the reduced rate.
                Store subscriber rates shown when toggled. Excludes sales
                tax (collected and remitted by eBay).
              </p>
            </div>
            <div class="tear"></div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section why">
    <div class="wrap">
      <div class="prose">
        <p class="eyebrow">How the math works</p>
        <h2>The 13.6% baseline: eBay's full cost stack</h2>
        <p>
          eBay's fee structure is more transparent than most marketplaces —
          one final value fee and one per-order charge cover everything,
          including payment processing. There is no separate transaction fee
          or payment processing line item. But the total cost of selling on
          eBay still surprises sellers who budget only for the headline
          rate. Here is what actually comes off your payout.
        </p>

        <h3>Layer 1: Final value fee (the headline cost)</h3>
        <p>
          For most categories, eBay charges 13.6% of the total sale amount
          — item price plus shipping charged to the buyer plus sales tax
          plus handling charges. That is higher than Amazon's 8–15% referral
          fee for most categories, but eBay includes payment processing
          in this single fee, while Amazon charges it separately. On a $50
          item with $10 shipping, the final value fee at 13.6% is $8.16:
        </p>
        <div class="formula-box">
          fvf = (price + shipping + tax) × fee_rate%
        </div>
        <p>
          Category matters enormously. Books, movies, and music carry 15.3%.
          Guitars and basses run only 6.7%. Sneakers over $150 are 8% with
          no per-order fee. The calculator includes all major category
          rates, so switch the dropdown to match what you sell.
        </p>
        <p>
          High-value sales also get a break: only the portion of the sale
          above a category threshold is charged the reduced rate — 2.35%
          over $7,500 in most categories for individual sellers, and over
          $2,500 for Store subscribers. A few categories differ (Jewelry &
          Watches, Auto Parts, Coins &amp; Paper Money), and the calculator
          applies each tier automatically.
        </p>

        <h3>Layer 2: Per-order fee (the small but constant charge)</h3>
        <p>
          On top of the percentage, eBay adds a flat per-order fee: $0.30
          for orders $10 or less, $0.40 for orders over $10. This is
          included in the final value fee — it is not a separate payment
          processing charge. On a $50 order, $0.40 adds 0.8% to the effective
          rate, bringing the real total to 14.4%. On a $10 order, the
          per-order fee alone is 3% — a significant bite on low-ticket
          items:
        </p>
        <div class="formula-box">
          per_order_fee = total_sale ≤ $10 ? $0.30 : $0.40
        </div>

        <h3>Layer 3: Store subscriber savings</h3>
        <p>
          eBay Store subscriptions ($4.95–$2,999.95/month) unlock
          discounted final value fees. For most categories, the rate drops
          from 13.6% to 12.7% — a 0.9% saving. But for certain categories
          the discount is dramatic: Consumer Electronics drops from 13.6%
          to 9.35% (4.25% saving), Computers from 13.6% to 7.35% (6.25%
          saving). If you sell $1,000/month of computers, the 6.25%
          saving ($62.50) dwarfs the Basic Store fee ($21.95/month billed
          annually; $27.95 month-to-month). Toggle
          the Store checkbox in the calculator to see if your category and
          volume justify the subscription.
        </p>

        <h3>Layer 4: Promoted listings (optional but often needed)</h3>
        <p>
          eBay's Promoted Listings Standard lets you boost visibility by
          setting an ad rate from 1% to 20% of the sale price. You only
          pay the ad fee if the item sells through a promoted placement —
          if it sells organically, you pay zero. Most sellers set 2–5%,
          which is enough to appear in search boosts without eroding
          margin. On a $50 item at 3%, that is $1.50 per promoted sale:
        </p>
        <div class="formula-box">
          promoted_fee = price × ad_rate%  (only on promoted sales)
        </div>
        <p>
          The calculator applies this to the item price only (not shipping),
          matching eBay's actual calculation. Enter 0% if you do not use
          promoted listings.
        </p>

        <h3>Layer 5: Insertion fees and listing upgrades</h3>
        <p>
          eBay gives 250 free listings per month. Beyond that, each listing
          costs $0.35 — charged at listing time, not at sale time. If you
          list 300 items and 280 sell, the 50 extra listings cost $17.50,
          spread across 280 sales = $0.06 per sale. For most casual sellers
          under 250 listings, this is zero. Optional upgrades (subtitles at
          $2, gallery plus, bold) are charged whether or not the item
          sells. Enter your average upgrade cost per listing if you use them.
        </p>

        <h3>The full stack on a typical sale</h3>
        <p>
          On a $50 electronics item with $10 shipping, 13.6% final value
          fee, $0.40 per-order, 3% promoted listings, $0 upgrades, $8
          shipping you pay, and $20 product cost: FVF $8.16 + per-order
          $0.40 + promoted $1.50 = $10.06 in eBay fees. Net revenue after
          eBay fees: $49.94. After product cost ($20) and shipping ($8),
          profit is $21.94 — a 43.9% margin. Not bad, but 14.4% of revenue
          went to eBay alone.
        </p>
        <p>
          The same item as a Store subscriber (9.35% electronics rate) would
          pay $5.61 FVF instead of $8.16 — saving $2.55 per sale. If you
          sell 10+ electronics items per month, the Basic Store fee
          ($21.95/month on annual billing) pays for itself. Use the <a
          href="/tools/amazon-fba-profit-calculator/">Amazon FBA
          calculator</a> to compare eBay vs Amazon for the same product, and
          the <a href="/tools/roas-break-even-calculator/">ROAS
          calculator</a> to check if your promoted listings ad rate is
          sustainable.
        </p>
      </div>
    </div>
  </section>

  <section class="section--tight section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Questions</p>
          <h2>eBay fee calculator FAQ</h2>
        </div>
      </div>
      <div class="faq">
        {
          faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div class="faq-body">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section--tight section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Keep calculating</p>
          <h2>Other free tools</h2>
        </div>
      </div>
      <div class="tool-grid">
        {related.map((t, i) => <ToolCard tool={t} delayClass={`rise-${Math.min(i + 1, 4)}`} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    max-width: 720px;
    margin-bottom: 40px;
    display: grid;
    gap: 14px;
  }
  .opt {
    font-weight: 400;
    opacity: 0.6;
    font-size: 0.85em;
  }
  .rl-sub-label {
    opacity: 0.6;
    font-size: 0.85em;
    margin-left: 4px;
  }
  .field-toggle {
    grid-column: 1 / -1;
  }
  .field-toggle label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-weight: 500;
  }
  .field-toggle input[type='checkbox'] {
    width: 18px;
    height: 18px;
    accent-color: var(--accent, #4f46e5);
    cursor: pointer;
  }
  .field-toggle span:not(.hint) {
    font-size: 0.95rem;
  }
</style>

<script type="application/json" id="ebay-fee-config" set:html={JSON.stringify({ perOrderUnder10, perOrderOver10 })}></script>

<script>
  function $<T extends HTMLElement = HTMLInputElement>(id: string): T {
    return document.getElementById(id) as T;
  }

  const money = (n: number) =>
    n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
  const pct = (n: number) => `${n.toFixed(1)}%`;

  function read(id: string): number {
    const v = parseFloat($(id).value);
    return Number.isFinite(v) && v >= 0 ? v : 0;
  }

  // Astro does not interpolate frontmatter values inside <script> tags,
  // so constants are passed in via a JSON block rendered in the template.
  const CFG = JSON.parse(
    (document.getElementById('ebay-fee-config') as HTMLScriptElement).textContent || '{}'
  ) as { perOrderUnder10: number; perOrderOver10: number };

  const PER_ORDER_UNDER_10 = CFG.perOrderUnder10;
  const PER_ORDER_OVER_10 = CFG.perOrderOver10;

  function recalc() {
    const price = read('price');
    const shipping = read('shipping');
    const cost = read('cost');
    const fulfillment = read('fulfillment');
    const promotedPct = Math.min(read('promoted'), 20);
    const upgrades = read('upgrades');
    const isStore = ($('store-sub') as HTMLInputElement).checked;

    const selected = $('category').selectedOptions[0] as HTMLOptionElement;
    const catId = selected?.value ?? 'most';
    const individualPct = parseFloat(selected?.dataset.individual ?? '13.6') || 13.6;
    const storePct = parseFloat(selected?.dataset.store ?? '12.7') || 12.7;
    const perOrderApplies = selected?.dataset.perOrder === '1';

    // Tiered rates: high-value sales pay a lower % on the portion above
    // a category threshold (e.g. 2.35% over $7,500 for most categories,
    // $2,500 for Store subscribers). Empty data attribute = flat rate.
    const num = (v: string | undefined) => {
      const n = parseFloat(v ?? '');
      return Number.isFinite(n) ? n : null;
    };
    const indThreshold = num(selected?.dataset.indThreshold);
    const indOver = num(selected?.dataset.indOver);
    const storeThreshold = num(selected?.dataset.storeThreshold);
    const storeOver = num(selected?.dataset.storeOver);

    const feeRate = isStore ? storePct : individualPct;
    const threshold = isStore ? storeThreshold : indThreshold;
    const overRate = isStore ? storeOver : indOver;

    // eBay calculates FVF on total sale amount (price + shipping + tax)
    // We simplify: total = price + shipping (tax is collected & remitted by eBay)
    const totalSale = price + shipping;

    // Final value fee (marginal: threshold portion at base rate, remainder
    // at the reduced over-rate)
    let fvf: number;
    if (threshold !== null && overRate !== null && totalSale > threshold) {
      fvf = threshold * (feeRate / 100) + (totalSale - threshold) * (overRate / 100);
      const eff = (fvf / totalSale) * 100;
      $('t-fvf-rate').textContent = `(${feeRate}% + ${overRate}% over $${threshold.toLocaleString('en-US')} · ${eff.toFixed(1)}% eff.)`;
    } else {
      fvf = totalSale * (feeRate / 100);
      $('t-fvf-rate').textContent = `(${feeRate}%)`;
    }

    // Per-order fee
    let perOrderFee = 0;
    if (perOrderApplies) {
      perOrderFee = totalSale <= 10 ? PER_ORDER_UNDER_10 : PER_ORDER_OVER_10;
    }

    // Promoted listings fee (on item price only)
    const promotedFee = price * (promotedPct / 100);

    // Total eBay fees
    const totalFees = fvf + perOrderFee + promotedFee + upgrades;

    // Net revenue after eBay fees
    const netRevenue = totalSale - totalFees;

    // Profit after product cost and shipping you pay
    const profit = netRevenue - cost - fulfillment;
    const margin = price > 0 ? (profit / price) * 100 : 0;
    const platformTake = price > 0 ? (totalFees / price) * 100 : 0;

    $('r-total').textContent = money(totalSale);
    $('r-fvf').textContent = `−${money(fvf)}`;
    $('r-perorder').textContent = `−${money(perOrderFee)}`;
    $('r-promoted').textContent = `−${money(promotedFee)}`;
    $('r-upgrades').textContent = `−${money(upgrades)}`;
    $('r-net').textContent = money(netRevenue);
    $('r-cost').textContent = `−${money(cost)}`;
    $('r-fulfillment').textContent = `−${money(fulfillment)}`;

    const profitEl = $('r-profit');
    profitEl.textContent = (profit < 0 ? '−' : '') + money(Math.abs(profit));
    profitEl.classList.toggle('pos', profit >= 0);
    profitEl.classList.toggle('neg', profit < 0);

    $('r-margin').textContent = pct(margin);
    $('r-take').textContent = pct(platformTake);

    const verdict = $('r-verdict');
    if (profit < 0) {
      verdict.className = 'verdict neg';
      verdict.textContent = 'selling at a loss ✕';
    } else if (margin >= 30) {
      verdict.className = 'verdict pos';
      verdict.textContent = 'healthy margin ✓';
    } else if (margin >= 15) {
      verdict.className = 'verdict pos';
      verdict.textContent = 'profitable — watch ad costs';
    } else if (margin >= 5) {
      verdict.className = 'verdict pos';
      verdict.textContent = 'thin margin — optimize fees';
    } else {
      verdict.className = 'verdict neg';
      verdict.textContent = 'barely breaking even ✕';
    }
  }

  ['price', 'shipping', 'cost', 'fulfillment', 'promoted', 'upgrades', 'category', 'store-sub'].forEach(
    (id) => $(id).addEventListener('input', recalc)
  );

  const copyBtn = document.getElementById('copy-btn')!;
  copyBtn.addEventListener('click', async () => {
    const lines = [
      'eBay profit (emallsoon.com)',
      `Total sale amount:   ${$('r-total').textContent}`,
      `Final value fee:     ${$('r-fvf').textContent}`,
      `Per-order fee:       ${$('r-perorder').textContent}`,
      `Promoted listings:   ${$('r-promoted').textContent}`,
      `Listing upgrades:    ${$('r-upgrades').textContent}`,
      `Net revenue:         ${$('r-net').textContent}`,
      `Product cost:        ${$('r-cost').textContent}`,
      `Shipping you pay:    ${$('r-fulfillment').textContent}`,
      `Profit/sale:         ${$('r-profit').textContent}`,
      `Margin:              ${$('r-margin').textContent}`,
      `Total platform take: ${$('r-take').textContent}`,
    ];
    try {
      await navigator.clipboard.writeText(lines.join('\n'));
      copyBtn.textContent = 'Copied ✓';
    } catch {
      copyBtn.textContent = 'Copy failed — select manually';
    }
    setTimeout(() => (copyBtn.textContent = 'Copy results'), 1800);
  });

  recalc();
</script>
